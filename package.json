{
  "name": "cs2assets",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single pipeline that updates CSGO-API, counter-strike-file-tracker and counter-strike-image-tracker",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.ts",
    "check": "node src/index.ts --check-only",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "@node-steam/vdf": "^2.2.0",
    "steam-user": "^5.3.0",
    "vpk": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
